{
    "layer": "top",
    "position": "top",
    "exclusive": true, // "false" 
    "spacing": 0,

    "modules-left": ["cpu", "custom/gpu", "memory", "temperature", "group/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mpris-marquee", "pulseaudio", "bluetooth", "custom/network", "hyprland/language", "custom/power"],

    // Workspace overview: workspaces.py writes one file per slot and signals waybar (RTMIN+9)
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws-daemon",
            "custom/ws-1",
            "custom/ws-2",
            "custom/ws-3",
            "custom/ws-4",
            "custom/ws-5",
            "custom/ws-6",
            "custom/ws-7",
            "custom/ws-8"
        ]
    },

    "custom/ws-daemon": {
        "exec": "~/.config/waybar/scripts/workspaces.py",
        "format": "",
        "tooltip": false
    },

    "custom/ws-1": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-1.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 1"
    },

    "custom/ws-2": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-2.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 2"
    },

    "custom/ws-3": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-3.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 3"
    },

    "custom/ws-4": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-4.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 4"
    },

    "custom/ws-5": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-5.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 5"
    },

    "custom/ws-6": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-6.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 6"
    },

    "custom/ws-7": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-7.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 7"
    },

    "custom/ws-8": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-ws/$WAYBAR_OUTPUT_NAME-8.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 8"
    },

    "cpu": {
        "interval": 1,
        "format": "CPU {usage}%",
    },

    "memory": {
        "interval": 1,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used} / {total}GiB",
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu_usage.sh",
        "format": "GPU {}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Skylake-H GT2: {}%"
    },
    
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
        "critical-threshold": 80,
        "interval": 1,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "CPU Temp: {temperatureC}°C",
        "on-click": "~/.config/waybar/scripts/toggle-gammastep"
    },
//  "format": "{:%H:%M}",
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "mode",
        "calendar": {
            "mode": "month",
            "mode-mons": "month",
            "on-scroll": 1,
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },

    "custom/mpris-marquee": {
        "exec": "~/.config/waybar/scripts/mpris-marquee.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" play-pause",
        "on-click-right": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" next",
        "on-click-middle": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" previous"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": false,
        "max-volume": 100,
        "on-click": "~/.config/waybar/scripts/sound-menu.py",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "Bluetooth: {status}\nNo devices connected",
        "tooltip-format-off": "Bluetooth: off",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  󰁹 {device_battery_percentage}%",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.py"
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network-status.py",
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/network-menu.py"
    },

    "hyprland/language": {
        "format": "{short}",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "pgrep -x wlogout >/dev/null || wlogout -b 1 -c 20 -r 20 -L 1700 -R 1700 -T 325 -B 325"
    }
}
